export function createLeadTaskPayload(lead: LeadSubmissionData): LeadTaskRecord {
  const dueDate = addBusinessHours(new Date(lead.submittedAt || new Date().toISOString()), 24).toISOString();
  return {
    id: `task_${lead.id}`,
    leadId: lead.id,
    title: `Review New Parcel Submission: ${lead.propertyAddress || lead.parcelNumber || 'New Parcel Submission'}`,
    priority: lead.askingPrice && lead.askingPrice !== 'Not Provided' ? 'High' : 'Normal',
    status: 'Pending Underwriting',
    dueDate,
    createdAt: new Date().toISOString(),
    sourceUrl: process.env.SITE_URL || 'https://abodebuys.com',
    summary: {
      fullName: lead.fullName,
      phone: lead.phone,
      email: lead.email,
      propertyAddress: lead.propertyAddress,
      county: lead.county,
      state: lead.state,
      parcelNumber: lead.parcelNumber,
      askingPrice: lead.askingPrice,
      lotSize: lead.acreage,
      gpsCoordinates: lead.gpsCoordinates || null,
      utilities: {
        water: lead.utilityWater,
        sewer: lead.utilitySewer,
        electric: lead.utilityElectric,
        gas: lead.utilityHeatingGas,
        internet: lead.utilityInternet,
        drainage: lead.utilityDrainage,
      },
      notes: lead.notes,
      titleStatus: lead.occupancyCondition,
      probateStatus: lead.probateDocumentationStatus || lead.ownershipStatus,
      smsConsentStatus: lead.smsConsent || lead.smsTransactionalConsent || lead.smsMarketingConsent ? 'Checked' : 'Unchecked',
    },
    checklist: [
      'Confirm parcel eligibility and county record status',
      'Verify mobile number and SMS consent status',
      'Validate seller contact details and property notes',
      'Check utilities, title, and deed status',
      'Schedule acquisition follow-up within business SLA',
    ],
  };
}

export async function createAcquisitionTask(
  lead: LeadSubmissionData
): Promise<{ created: boolean; taskId: string; task?: LeadTaskRecord; error?: string }> {
  const task = createLeadTaskPayload(lead);

  try {
    fs.appendFileSync(TASK_LOG_FILE, `${JSON.stringify(task)}\n`, 'utf-8');
    console.log(`[Task] Local task ledger updated: ${task.id}`);
  } catch (err) {
    console.error('[Task] Failed to write local task ledger:', err);
  }

  if (db) {
    try {
      await setDoc(doc(db, 'acquisitionTasks', task.id), task);
      console.log(`[Task] Created: ${task.id}`);
      return { created: true, taskId: task.id, task };
    } catch (err) {
      const message = err instanceof Error ? err.message : 'Unknown Firestore task error';
      console.error('[Task] Firestore write failed:', message);
      return { created: false, taskId: task.id, task, error: message };
    }
  }

  return { created: true, taskId: task.id, task };
}

function getLeadWebhookUrl(): string | undefined {
  return process.env.LEAD_WEBHOOK_URL || process.env.ZAPIER_WEBHOOK_URL || process.env.MAKE_WEBHOOK_URL || process.env.CRM_WEBHOOK_URL;
}

async function dispatchWebhookEvent(payload: Record<string, unknown>): Promise<boolean> {
  const webhookUrl = getLeadWebhookUrl();
  if (!webhookUrl) {
    return false;
  }

  try {
    const response = await fetch(webhookUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });

    if (!response.ok) {
      const text = await response.text().catch(() => 'No response body');
      console.error(`[Webhook] ${response.status}: ${text}`);
      return false;
    }

    console.log(`[Webhook] Dispatched lead event to ${webhookUrl}: HTTP ${response.status}`);
    return true;
  } catch (err) {
    console.error('[Webhook] Network/fetch failure:', err);
    return false;
  }
}

async function sendResendEmail(to: string, subject: string, html: string): Promise<boolean> {
  const apiKey = process.env.RESEND_API_KEY;
  if (!apiKey) {
    throw new Error('RESEND_API_KEY not configured');
  }

  const from = process.env.RESEND_FROM || 'Acquisitions Desk <onboarding@resend.dev>';
  const response = await fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      from,
      to: [to],
      subject,
      html,
    }),
  });

  if (!response.ok) {
    const errorText = await response.text().catch(() => 'No response body');
    const errorMessage = `${response.status} ${errorText}`;
    console.error(`[Resend Error] ${errorMessage}`);
    throw new Error(errorMessage);
  }

  const data = await response.json().catch(() => ({}));
  console.log(`[Resend] Email sent: id=${data.id || 'unknown'}`);
  return true;
}

async function sendSmtpEmail(to: string, subject: string, html: string): Promise<boolean> {
  const host = process.env.SMTP_HOST;
  const port = Number(process.env.SMTP_PORT || 587);
  const user = process.env.SMTP_USER;
  const pass = process.env.SMTP_PASS;

  if (!host || !user || !pass) {
    throw new Error('SMTP_HOST, SMTP_USER, and SMTP_PASS are missing');
  }

  const transporter = nodemailer.createTransport({
    host,
    port,
    secure: port === 465,
    auth: { user, pass },
  });

  const info = await transporter.sendMail({
    from: process.env.SMTP_FROM || user,
    to,
    subject,
    html,
  });

  console.log(`[SMTP] Email sent: ${info.messageId}`);
  return true;
}

export async function dispatchLeadNotifications(
  lead: LeadSubmissionData,
  taskId?: string
): Promise<{ emailDispatched: boolean; taskCreated: boolean; taskId?: string }> {
  const targetEmail = getTargetNotificationEmail();
  const taskCreated = Boolean(taskId);
  const html = buildLeadNotificationHtml(lead);
  const subject = `New Parcel Intake Alert - ${lead.propertyAddress || lead.parcelNumber || 'Property Inquiry'}`;

  let emailDispatched = false;

  try {
    if (process.env.RESEND_API_KEY) {
      emailDispatched = await sendResendEmail(targetEmail, subject, html);
    } else if (process.env.SMTP_HOST && process.env.SMTP_USER && process.env.SMTP_PASS) {
      emailDispatched = await sendSmtpEmail(targetEmail, subject, html);
    } else {
      console.log(`[LeadService] No email transport configured; lead alert logged locally for ${targetEmail}.`);
      emailDispatched = false;
    }
  } catch (err) {
    console.error('[LeadService:Error] Email dispatch failure:', err);
    emailDispatched = false;
  }

  const webhookUrl = getLeadWebhookUrl();
  if (webhookUrl) {
    const payload = {
      event: 'lead.submitted_and_task_created',
      leadId: lead.id,
      taskId,
      timestamp: lead.submittedAt,
      lead,
      notification: {
        emailTo: targetEmail,
        emailDispatched,
      },
    };

    await dispatchWebhookEvent(payload);
  }

  return { emailDispatched, taskCreated, taskId };
}

/**
 * Persists lead to Firestore and immutable backup JSON audit file,
 * then triggers asynchronous alerts to the acquisition desk without blocking.
 */
export async function processIncomingLead(leadData: LeadSubmissionData): Promise<{
  success: boolean;
  leadId: string;
  taskId?: string;
  persistedTo: string[];
  timestamp: string;
}> {
  const persistedTo: string[] = [];

  try {
    const logEntry = JSON.stringify(leadData) + '\n';
    fs.appendFileSync(AUDIT_LOG_FILE, logEntry, 'utf-8');
    persistedTo.push('audit_log');
  } catch (logErr) {
    console.error('[LeadService] Failed to append to audit log:', logErr);
  }

  if (db) {
    try {
      const leadRef = doc(db, 'leads', leadData.id);
      await setDoc(leadRef, {
        ...leadData,
        updatedAt: new Date().toISOString(),
      });
      persistedTo.push('firestore');
      console.log(`[LeadService] Lead ${leadData.id} persisted to Firestore collection 'leads'`);
    } catch (dbErr) {
      console.error(`[LeadService] Firestore write failed for lead ${leadData.id}:`, dbErr);
    }
  }

  const taskResult = await createAcquisitionTask(leadData);
  if (taskResult.taskId) {
    persistedTo.push('acquisition_task');
  }

  void dispatchLeadNotifications(leadData, taskResult.taskId).catch((notifErr) => {
    console.error('[LeadService] Asynchronous notification error:', notifErr);
  });

  return {
    success: true,
    leadId: leadData.id,
    taskId: taskResult.taskId,
    persistedTo,
    timestamp: leadData.submittedAt,
  };
}

/**
 * Retrieves the most recent leads from the immutable audit log
 */
export function getRecentAuditLeads(limit = 50): LeadSubmissionData[] {
  if (!fs.existsSync(AUDIT_LOG_FILE)) {
    return [];
  }
  try {
    const content = fs.readFileSync(AUDIT_LOG_FILE, 'utf-8');
    const lines = content.trim().split('\n').filter(Boolean);
    const leads = lines
      .map((line) => {
        try {
          return JSON.parse(line) as LeadSubmissionData;
        } catch {
          return null;
        }
      })
      .filter((l): l is LeadSubmissionData => l !== null);

    return leads.reverse().slice(0, limit);
  } catch (err) {
    console.error('[LeadService] Error reading audit log:', err);
    return [];
  }
}

export async function dispatchLeadTaskEmail(lead: LeadSubmissionData): Promise<{ success: boolean; taskId?: string }> {
  const taskResult = await createAcquisitionTask(lead);
  const emailReport = await dispatchLeadNotifications(lead, taskResult.taskId);
  return {
    success: emailReport.emailDispatched || Boolean(taskResult.taskId),
    taskId: taskResult.taskId,
  };
}

