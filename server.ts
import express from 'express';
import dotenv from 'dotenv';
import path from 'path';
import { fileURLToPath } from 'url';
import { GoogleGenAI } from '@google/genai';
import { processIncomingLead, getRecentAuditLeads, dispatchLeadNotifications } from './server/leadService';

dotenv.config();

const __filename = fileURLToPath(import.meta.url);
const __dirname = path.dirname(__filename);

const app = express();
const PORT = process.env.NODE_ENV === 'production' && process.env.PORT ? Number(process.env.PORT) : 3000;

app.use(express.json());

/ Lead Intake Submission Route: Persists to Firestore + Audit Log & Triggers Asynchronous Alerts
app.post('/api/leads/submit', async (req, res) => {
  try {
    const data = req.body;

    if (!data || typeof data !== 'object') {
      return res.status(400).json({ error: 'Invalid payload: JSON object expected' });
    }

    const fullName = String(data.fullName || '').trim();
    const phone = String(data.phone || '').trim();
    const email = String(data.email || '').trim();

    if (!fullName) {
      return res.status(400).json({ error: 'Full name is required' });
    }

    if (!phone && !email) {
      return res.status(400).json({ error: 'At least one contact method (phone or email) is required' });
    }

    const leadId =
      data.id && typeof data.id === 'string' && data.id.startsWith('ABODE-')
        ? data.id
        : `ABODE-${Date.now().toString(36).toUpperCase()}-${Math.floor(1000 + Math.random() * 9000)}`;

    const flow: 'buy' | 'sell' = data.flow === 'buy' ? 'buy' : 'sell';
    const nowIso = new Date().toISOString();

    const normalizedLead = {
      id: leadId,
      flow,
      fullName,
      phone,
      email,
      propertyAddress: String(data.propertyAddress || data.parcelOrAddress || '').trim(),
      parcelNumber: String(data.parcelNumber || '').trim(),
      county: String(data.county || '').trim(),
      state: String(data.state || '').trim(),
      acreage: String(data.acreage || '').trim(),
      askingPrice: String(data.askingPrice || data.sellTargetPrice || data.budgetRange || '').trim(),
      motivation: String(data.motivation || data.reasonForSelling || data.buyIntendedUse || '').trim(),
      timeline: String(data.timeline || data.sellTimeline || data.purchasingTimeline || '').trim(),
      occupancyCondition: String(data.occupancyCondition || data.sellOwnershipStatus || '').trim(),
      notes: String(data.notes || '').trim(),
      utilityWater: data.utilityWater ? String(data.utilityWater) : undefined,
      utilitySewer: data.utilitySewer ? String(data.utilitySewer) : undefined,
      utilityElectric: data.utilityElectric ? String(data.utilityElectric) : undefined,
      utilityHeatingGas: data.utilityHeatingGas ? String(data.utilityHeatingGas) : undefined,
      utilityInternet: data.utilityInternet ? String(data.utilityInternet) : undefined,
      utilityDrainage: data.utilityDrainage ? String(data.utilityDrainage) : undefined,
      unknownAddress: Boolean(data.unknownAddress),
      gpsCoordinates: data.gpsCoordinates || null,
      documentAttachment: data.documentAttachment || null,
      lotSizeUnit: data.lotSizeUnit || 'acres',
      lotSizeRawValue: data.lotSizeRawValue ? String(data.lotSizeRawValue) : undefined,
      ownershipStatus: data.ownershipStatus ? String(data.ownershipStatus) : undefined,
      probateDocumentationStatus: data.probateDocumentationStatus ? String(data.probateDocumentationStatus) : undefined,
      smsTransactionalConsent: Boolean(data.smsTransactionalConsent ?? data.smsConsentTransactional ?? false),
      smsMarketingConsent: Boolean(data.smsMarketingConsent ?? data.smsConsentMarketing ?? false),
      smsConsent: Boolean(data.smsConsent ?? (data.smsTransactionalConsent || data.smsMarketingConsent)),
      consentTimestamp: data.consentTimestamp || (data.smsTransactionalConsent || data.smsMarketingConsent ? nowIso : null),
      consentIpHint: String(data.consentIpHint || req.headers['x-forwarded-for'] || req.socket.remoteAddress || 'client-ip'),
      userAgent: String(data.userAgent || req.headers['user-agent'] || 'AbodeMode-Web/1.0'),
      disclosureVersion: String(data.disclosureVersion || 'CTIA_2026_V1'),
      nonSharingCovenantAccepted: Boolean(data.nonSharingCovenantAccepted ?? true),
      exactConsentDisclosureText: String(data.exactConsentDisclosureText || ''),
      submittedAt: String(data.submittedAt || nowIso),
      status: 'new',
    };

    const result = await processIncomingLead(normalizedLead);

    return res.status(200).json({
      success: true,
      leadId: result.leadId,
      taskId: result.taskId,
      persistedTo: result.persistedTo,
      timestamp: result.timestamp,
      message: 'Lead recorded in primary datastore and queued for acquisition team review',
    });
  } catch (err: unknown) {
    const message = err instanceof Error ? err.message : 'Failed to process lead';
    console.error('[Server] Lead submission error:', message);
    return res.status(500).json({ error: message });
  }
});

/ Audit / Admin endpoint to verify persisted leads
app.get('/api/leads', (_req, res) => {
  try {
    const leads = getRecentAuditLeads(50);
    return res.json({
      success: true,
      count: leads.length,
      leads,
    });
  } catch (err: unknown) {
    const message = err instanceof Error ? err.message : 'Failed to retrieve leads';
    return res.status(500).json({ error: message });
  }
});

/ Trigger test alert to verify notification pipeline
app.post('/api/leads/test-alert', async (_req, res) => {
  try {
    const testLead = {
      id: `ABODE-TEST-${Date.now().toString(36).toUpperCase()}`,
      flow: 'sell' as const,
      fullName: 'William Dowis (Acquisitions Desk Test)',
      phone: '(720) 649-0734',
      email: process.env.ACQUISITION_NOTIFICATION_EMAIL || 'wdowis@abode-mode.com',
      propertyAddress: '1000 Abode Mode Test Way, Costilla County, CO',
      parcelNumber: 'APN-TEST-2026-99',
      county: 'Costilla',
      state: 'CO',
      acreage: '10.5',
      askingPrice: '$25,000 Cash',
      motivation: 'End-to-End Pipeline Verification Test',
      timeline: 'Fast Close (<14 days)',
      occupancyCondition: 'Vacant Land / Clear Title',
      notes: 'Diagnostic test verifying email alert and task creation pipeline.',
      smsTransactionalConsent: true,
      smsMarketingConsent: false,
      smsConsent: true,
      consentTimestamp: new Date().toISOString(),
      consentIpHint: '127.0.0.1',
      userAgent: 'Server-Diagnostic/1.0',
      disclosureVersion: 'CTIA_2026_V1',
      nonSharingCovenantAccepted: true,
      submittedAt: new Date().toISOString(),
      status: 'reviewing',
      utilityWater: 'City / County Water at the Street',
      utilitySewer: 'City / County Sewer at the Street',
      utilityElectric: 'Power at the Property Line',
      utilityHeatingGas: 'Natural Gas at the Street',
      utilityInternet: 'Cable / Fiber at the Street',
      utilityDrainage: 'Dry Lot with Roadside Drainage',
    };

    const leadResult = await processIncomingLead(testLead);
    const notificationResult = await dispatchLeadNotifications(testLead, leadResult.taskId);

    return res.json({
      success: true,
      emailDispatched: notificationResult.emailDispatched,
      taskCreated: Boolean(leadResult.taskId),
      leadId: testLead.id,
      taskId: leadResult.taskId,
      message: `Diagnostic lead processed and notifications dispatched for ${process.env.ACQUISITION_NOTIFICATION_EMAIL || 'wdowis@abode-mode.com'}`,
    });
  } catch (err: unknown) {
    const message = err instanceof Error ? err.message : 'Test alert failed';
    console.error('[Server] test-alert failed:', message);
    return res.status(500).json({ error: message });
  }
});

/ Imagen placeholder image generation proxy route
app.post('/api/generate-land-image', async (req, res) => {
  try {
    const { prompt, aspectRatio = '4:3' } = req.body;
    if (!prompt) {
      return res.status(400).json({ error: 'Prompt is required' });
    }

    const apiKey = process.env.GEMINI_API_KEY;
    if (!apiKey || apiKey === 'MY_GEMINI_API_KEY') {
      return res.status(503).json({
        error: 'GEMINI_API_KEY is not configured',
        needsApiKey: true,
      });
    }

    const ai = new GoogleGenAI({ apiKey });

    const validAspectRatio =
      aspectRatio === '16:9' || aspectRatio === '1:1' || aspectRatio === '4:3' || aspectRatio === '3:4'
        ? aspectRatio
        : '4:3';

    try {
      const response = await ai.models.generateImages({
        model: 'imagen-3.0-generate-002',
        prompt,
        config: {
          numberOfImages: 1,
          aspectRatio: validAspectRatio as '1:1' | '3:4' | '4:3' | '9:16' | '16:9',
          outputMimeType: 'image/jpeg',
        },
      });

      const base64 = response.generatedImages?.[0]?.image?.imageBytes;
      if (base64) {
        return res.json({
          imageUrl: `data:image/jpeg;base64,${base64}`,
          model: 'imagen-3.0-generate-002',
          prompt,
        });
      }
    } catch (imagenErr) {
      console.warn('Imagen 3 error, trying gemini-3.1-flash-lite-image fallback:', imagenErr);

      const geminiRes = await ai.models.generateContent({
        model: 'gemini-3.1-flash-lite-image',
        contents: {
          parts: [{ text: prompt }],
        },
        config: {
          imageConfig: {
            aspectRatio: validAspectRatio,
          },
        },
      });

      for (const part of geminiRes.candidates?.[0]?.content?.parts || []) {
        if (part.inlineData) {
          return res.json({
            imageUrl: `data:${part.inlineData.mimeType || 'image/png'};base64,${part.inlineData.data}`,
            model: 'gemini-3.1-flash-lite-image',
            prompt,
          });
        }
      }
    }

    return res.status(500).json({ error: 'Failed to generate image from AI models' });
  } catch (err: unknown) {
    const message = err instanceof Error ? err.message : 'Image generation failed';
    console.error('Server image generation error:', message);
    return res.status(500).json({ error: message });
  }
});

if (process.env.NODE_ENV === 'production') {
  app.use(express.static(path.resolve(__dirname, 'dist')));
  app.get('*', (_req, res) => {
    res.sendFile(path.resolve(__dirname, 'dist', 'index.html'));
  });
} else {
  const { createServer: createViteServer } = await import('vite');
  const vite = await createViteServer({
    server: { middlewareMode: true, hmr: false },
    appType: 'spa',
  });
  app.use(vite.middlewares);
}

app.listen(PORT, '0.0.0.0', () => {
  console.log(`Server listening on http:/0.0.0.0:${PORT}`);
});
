function addBusinessHours(start: Date, hours: number): Date {
  const result = new Date(start);
  let remainingMs = hours * 60 * 60 * 1000;

  while (remainingMs > 0) {
    const day = result.getUTCDay();
    const hour = result.getUTCHours();
    const inBusinessHours = day >= 1 && day <= 5 && hour >= 9 && hour < 17;

    if (inBusinessHours) {
      const msUntilClose = (17 - hour) * 60 * 60 * 1000;
      const slice = Math.min(remainingMs, msUntilClose);
      result.setTime(result.getTime() + slice);
      remainingMs -= slice;

      if (remainingMs > 0) {
        const next = new Date(result);
        next.setUTCDate(next.getUTCDate() + 1);
        next.setUTCHours(9, 0, 0, 0);

        while (next.getUTCDay() === 0 || next.getUTCDay() === 6) {
          next.setUTCDate(next.getUTCDate() + 1);
        }

        result.setTime(next.getTime());
      }
      continue;
    }

    const next = new Date(result);
    if (day === 0) {
      next.setUTCDate(next.getUTCDate() + 1);
    } else if (day === 6) {
      next.setUTCDate(next.getUTCDate() + 2);
    }

    if (next.getUTCHours() < 9) {
      next.setUTCHours(9, 0, 0, 0);
    }

    if (next.getUTCHours() >= 17) {
      next.setUTCDate(next.getUTCDate() + 1);
      next.setUTCHours(9, 0, 0, 0);
    }

    while (next.getUTCDay() === 0 || next.getUTCDay() === 6) {
      next.setUTCDate(next.getUTCDate() + 1);
    }

    result.setTime(next.getTime());
  }

  return result;
}

function getTargetNotificationEmail(): string {
