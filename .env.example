# ============================================================
# Abode Mode - Backend & Integration Environment Configuration
# ============================================================

# Primary Acquisitions Desk Alert Email (Default: wdowis@abodebuys.com)
ACQUISITION_NOTIFICATION_EMAIL=wdowis@abodebuys.com

# Extensible Inbound Lead Webhook (Zapier / Make / CRM / Inbound SMS Gateway)
# Leave blank or configure with your webhook endpoint URL
LEAD_WEBHOOK_URL=

# (Optional) Resend API Key for automated transactional email dispatch
RESEND_API_KEY=

# Server Port (defaults to 3000 for AI Studio environment)
PORT=3000

# Gemini API Key for server-side land visualization proxy
GEMINI_API_KEY=

# Firebase Configuration (loaded from firebase-applet-config.json by default)
FIREBASE_API_KEY=
